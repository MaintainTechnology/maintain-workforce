{
  "$meta": {
    "name": "Maintain Workforce Design Tokens",
    "sources": ["assets/logo/maintain-workforce-logo-lightbg.svg (the brand mark)"],
    "note": "No website exists yet — the logo is the brand definition. Ink Teal + Hi-Vis Amber + Manrope. Build against `semantic` roles, not raw brand values."
  },
  "brand": {
    "black": "#101820",
    "black-2": "#0C1319",
    "black-3": "#1A2330",
    "ink-teal": "#07272D",
    "teal-deep": "#051F24",
    "teal-mist": "#66A1AB",
    "amber": "#FFC400",
    "amber-mid": "#C79600",
    "amber-deep": "#8F6400",
    "amber-dark": "#5C4700",
    "amber-tint-1": "#FFF4CC",
    "amber-tint-2": "#FFE699",
    "cloud": "#F5F5F1",
    "white": "#FFFFFF",
    "ink": "#1F2D2B",
    "slate": "#64748B",
    "surface-cream-1": "#FFFBEE",
    "surface-cream-2": "#FAF4E0"
  },
  "semantic": {
    "bg": "ink-teal", "bg-deep": "black", "surface": "white", "surface-soft": "cloud",
    "text": "ink", "text-muted": "slate", "primary": "amber",
    "primary-ink": "ink-teal", "accent": "amber",
    "line": "rgba(255,255,255,0.10)", "line-light": "rgba(7,39,45,0.12)",
    "on-dark": "#FFFFFF", "on-dark-muted": "rgba(255,255,255,0.70)", "on-dark-faint": "rgba(255,255,255,0.55)"
  },
  "status": {
    "_note": "One hue per status, >=3:1 as a non-text dot on white and on the brand darks. Render as a small dot + neutral uppercase label; color never carries the label.",
    "active": "#22A05B",
    "scheduled": "#3B82F6",
    "pending": "#D97706",
    "overdue": "#EA580C",
    "critical": "#DC2626"
  },
  "typography": {
    "display": "Manrope", "body": "Manrope",
    "tracking": { "display": "-0.02em", "tight": "-0.01em", "caps": "0.08em" },
    "leading": { "display": 1.05, "body": 1.6 },
    "scale": {
      "display": "clamp(2.75rem,6vw,4.5rem)", "h1": "clamp(2rem,4vw,3rem)",
      "h2": "clamp(1.5rem,3vw,2rem)", "h3": "1.375rem", "h4": "1.125rem",
      "body-lg": "1.125rem", "body": "1rem", "sm": "0.875rem", "xs": "0.75rem", "overline": "0.6875rem"
    },
    "weights": { "display": [700, 800], "body": [400, 500, 600] }
  },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px", "6": "32px", "7": "48px", "8": "64px", "9": "96px", "10": "128px" },
  "radius": { "sharp": "0", "sm": "6px", "md": "10px", "lg": "16px", "xl": "24px", "pill": "999px" },
  "shadow": {
    "sm": "0 1px 2px rgba(7,39,45,.08)", "md": "0 6px 20px rgba(7,39,45,.12)",
    "lg": "0 20px 50px rgba(5,31,36,.35)", "glow-amber": "0 0 40px rgba(255,196,0,.25)"
  },
  "background": {
    "grid-line": "rgba(255,196,0,0.05)", "grid-size": "40px",
    "grid": "linear-gradient(var(--grid-line) 1px, transparent 1px), linear-gradient(90deg, var(--grid-line) 1px, transparent 1px)",
    "glow": "radial-gradient(60% 60% at 70% 18%, rgba(255,196,0,.16), transparent 70%)"
  },
  "motion": { "fast": "120ms", "base": "200ms", "slow": "320ms", "ease-out": "cubic-bezier(0.22,1,0.36,1)" },
  "assets": {
    "logo": {
      "primary": "assets/logo/maintain-workforce-logo-lightbg.svg",
      "wordmark-on-dark": "assets/logo/wordmark-on-dark.svg",
      "wordmark-on-light": "assets/logo/wordmark-on-light.svg"
    },
    "icons": "assets/icons/ (i-check, i-clipboard, i-search, i-shield, i-chart, i-network, i-speed, i-star, i-cpu, i-mail, i-phone, i-pin, i-arrow-right, i-menu)",
    "sprite": "assets/sprite.svg"
  }
}
