# Copy to .env.local and fill in. .env.local is gitignored.

# Canonical site origin — drives metadataBase, sitemap.xml, robots.txt and OG URLs.
# Production (set in Vercel → Settings → Environment Variables): https://maintainworkforce.com.au
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (transactional email for the site forms). https://resend.com/api-keys
# The from-domain must be verified in Resend; without it the code falls back
# to onboarding@resend.dev.
RESEND_FROM_EMAIL="Maintain Workforce <noreply@maintainworkforce.com.au>"
RESEND_API_KEY=
# Where enquiries are delivered.
BOOKING_NOTIFICATION_EMAIL=

# Google AI Studio key for generating site imagery (Nano Banana Pro). Not
# required to run the site; image slots fall back to brand art without it.
GEMINI_API_KEY=

# SECRETS LIVE IN .env.local (gitignored), NEVER IN THIS FILE: this template
# is meant to be committed, and a key pasted here ships to every clone.
