# Copy to .env.local and fill in. Secrets (20.2) never appear in the repo or any
# client bundle; the build fails if the service-role key reaches client output.

# Clerk is the identity provider for sign-up, sign-in, sessions and invitations.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/signin
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup

# Supabase stores application data and files. Enable Clerk as a third-party auth
# provider (or keep the existing "supabase" Clerk JWT template) before using RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Transactional application email (15.1). Clerk owns authentication email delivery.
RESEND_API_KEY=
# Verified sender for marketing-site mail; platform mail uses the notify module.
RESEND_FROM_EMAIL=

# Where Maintain-bound notifications land (15.2 rows addressed to Maintain).
# BOOKING_NOTIFICATION_EMAIL is the legacy marketing-site name for the same inbox
# and is read as a fallback.
MAINTAIN_NOTIFICATION_EMAIL=
BOOKING_NOTIFICATION_EMAIL=

# Lead webhook (0.2) — the funnel tool must present this token.
LEAD_WEBHOOK_TOKEN=

# Daily job (module 19 executor table) — rejects unauthenticated calls.
CRON_SECRET=

# Absolute base for deep links in notifications and invitation redirects.
APP_BASE_URL=http://localhost:3000

# Public marketing-site origin (canonical URLs, OG tags).
# Production: https://maintainworkforce.com.au
NEXT_PUBLIC_SITE_URL=http://localhost:3000
